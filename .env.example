# Public template only. Copy this file to .env locally.
# Never commit .env, Streamlit secrets, API keys, service-account files, or customer data.

# Optional structured AI providers
OPENAI_API_KEY=
OPENAI_ADVISOR_MODEL=
OPENAI_DOCUMENT_MODEL=

# Optional grounded Live AI explanation layer
OPENAI_MODEL=gpt-5-mini
OPENAI_LIVE_AI_TIMEOUT_SECONDS=45
OPENAI_LIVE_AI_MAX_OUTPUT_TOKENS=1400

# Optional official-data providers
BOK_ECOS_API_KEY=
KEXIM_API_KEY=
OPENDART_API_KEY=
DATA_GO_KR_SERVICE_KEY=
NTS_BUSINESS_API_KEY=

# Optional global trade-data provider
UN_COMTRADE_API_KEY=

# Provider behavior
TRADEGUARD_LIVE_DATA=false
TRADEGUARD_CACHE_DIR=data/cache
TRADEGUARD_ALLOW_STALE_FIXTURES=true
